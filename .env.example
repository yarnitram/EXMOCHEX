# ==============================================================================
# EXMOCHEX - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate the values below.

# --- Supabase Instance Credentials (Proxmox Self-Hosted or Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://sup.yourdomain.online
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Platform Admins (comma-separated email addresses) ---
ADMIN_EMAILS=martinraygales@gmail.com,arawsikat21@gmail.com

# --- 24/7 Background Alert Watcher Settings ---
POLL_INTERVAL=2

# Fallback Notification Channels (optional global fallback if not set in user profile)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO...
# TELEGRAM_CHAT_ID=123456789

# --- Optional: TradingView & Cloud Integrations ---
# TRADINGVIEW_WEBHOOK_SECRET=your_custom_secret
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id
